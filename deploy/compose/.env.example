# TransForge container settings. Copy to ".env" next to compose.yml.
# Never commit the real .env (it is git-ignored) and keep it chmod 0600.

# --- the LLM server, as seen from inside the container ------------------------
# StudioForge / llama.cpp on the Docker host. Used once, to seed endpoint in
# config/config.toml on the first start (a trailing /v1 is dropped).
LLM_BASE_URL=http://host.docker.internal:1234/v1

# StudioForge API key, sent as `Authorization: Bearer` on every request. Leave
# empty if the server needs none.
TRANSFORGE_LLM_API_KEY=

# Legacy StudioForge management PIN (warmup / load-recommended). Deprecated:
# not needed when an API key is set. Without either, TransForge warns and runs
# against whatever plan the server has.
STUDIOFORGE_MCP_PIN=

# Only for the opt-in `transforge review` stage (hosted API). The variable NAME
# must match [review] api_key_env in config.toml.
DEEPSEEK_API_KEY=

# --- paths on the host ---------------------------------------------------------
# CONFIG_PATH=./config      # holds config.toml (relative to this file)
# SITES_PATH=./sites        # your site trees; mounted at /sites, written in place

# --- optional `schedule` service -----------------------------------------------
# TRANSFORGE_SCHEDULE_CMD=run --site example
# TRANSFORGE_INTERVAL=3600

TZ=UTC
MEM_LIMIT=512m
CPU_LIMIT=1.0
